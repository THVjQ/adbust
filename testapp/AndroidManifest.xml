<?xml version="1.0" encoding="utf-8"?>
<!--
  adbust fake-adware test app. Harmless: it collects nothing and has no
  network permission. It exists so the scanner, the live watcher and the
  remove buttons can be exercised on a real handset without touching a real
  app. It deliberately looks bad: a junkware-style name, overlay permission,
  a hidden-ish popup activity, and a service that throws a full-screen "ad"
  every 15 seconds once it has been opened.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.thvjq.adbusttest.pdfscanner"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application android:label="PDF Scanner (adbust test)"
        android:allowBackup="false">

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AdActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".ad" />

        <service android:name=".PopupService" android:exported="false" />
    </application>
</manifest>
